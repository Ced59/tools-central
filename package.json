{
  "name": "tools-central",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "i18n:locales": "node scripts/generate-locales.mjs",
    "start": "npm run i18n:locales && npm run pdfjs:prepare-privacy-worker && ng serve",
    "build": "npm run i18n:locales && npm run pdfjs:prepare-privacy-worker && ng build && npm run postbuild:assets",
    "watch": "npm run i18n:locales && npm run pdfjs:prepare-privacy-worker && ng build --watch --configuration development",
    "test": "npm run test:scripts && ng test --watch=false",
    "test:coverage": "npm run test:scripts && ng test --watch=false --coverage",
    "test:scripts": "node --test scripts/pdfjs-privacy-worker-patch.test.mjs",
    "test:e2e": "playwright test",
    "lint": "ng lint --max-warnings=0",
    "pr:validate": "node scripts/validate-pr-scope.mjs",
    "check": "npm run lint && npm run i18n:check:strict && npm run catalog:validate && npm run architecture:validate && npm test",
    "editorials:gen": "node scripts/editorials-generate.mjs",
    "editorials:gen:dry": "node scripts/editorials-generate.mjs --dry",
    "editorials:gen:force": "node scripts/editorials-generate.mjs --force",
    "extract-i18n": "ng extract-i18n --project=tools-central",
    "i18n:sync": "node scripts/i18n-sync.mjs",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "i18n:status": "node scripts/i18n-status.mjs",
    "i18n:check:strict": "node scripts/i18n-validate.mjs --strict && node scripts/i18n-status.mjs --strict",
    "i18n:auto": "npm run extract-i18n && npm run i18n:sync && npm run i18n:translate",
    "i18n:check": "npm run i18n:validate && npm run i18n:status",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "architecture:validate": "node scripts/validate-architecture.mjs",
    "seo:validate": "node scripts/validate-seo-output.mjs",
    "build:all": "node scripts/generate-prerender-routes.mjs && npm run build && npm run postbuild:seo",
    "pdfjs:prepare-privacy-worker": "node scripts/prepare-pdfjs-privacy-worker.mjs",
    "postbuild:assets": "node scripts/stage-pdfjs-assets.mjs",
    "postbuild:seo": "node scripts/generate-sitemaps.mjs && node scripts/generate-robots.mjs && node scripts/generate-ads-txt.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/ssr": "^22.1.8",
    "entities": "^7.0.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "ngx-matomo-client": "^10.0.0",
    "pako": "^3.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/localize": "^22.1.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-rxjs-x": "^1.0.6",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
